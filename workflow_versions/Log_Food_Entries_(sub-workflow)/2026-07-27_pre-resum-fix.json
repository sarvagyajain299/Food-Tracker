    {"id":"f2530e98-eba4-4442-a490-6b050153855e","name":"Execute Workflow Trigger","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.2,"position":[240,300],"parameters":{"inputSource":"workflowInputs","workflowInputs":{"values":[{"name":"entries","type":"array"}]}}},
    {"id":"fc886725-272f-4f2f-be9b-5d357a34b491","name":"Read Food Database","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[540,300],"parameters":{"resource":"sheet","operation":"read","documentId":{"__rl":true,"mode":"id","value":"YOUR_GOOGLE_SHEET_ID","cachedResultName":"Food Tracker"},"sheetName":{"__rl":true,"mode":"id","value":"1139186833","cachedResultName":"food database"},"options":{}},"retryOnFail":true},
    {"id":"e04c6296-c7fb-4a9c-bbac-655098b11363","name":"Build Entry Rows","type":"n8n-nodes-base.code","typeVersion":2,"position":[840,300],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const entries = $('Execute Workflow Trigger').item.json.entries;\nconst foodDb = $input.all().map(item => item.json);\nconst now = $now.setZone('Asia/Kolkata');\nconst day = now.toFormat('cccc');\nconst date = now.toFormat('LLLL d');\n\nreturn entries.map(entry => {\n  const food = foodDb.find(f => f['Food ID'] === entry.food_id);\n  if (!food) {\n    throw new Error('Unknown food_id: ' + entry.food_id + ' — this food is not in the database. Use lookup_food_on_web and add_new_food_to_database first.');\n  }\n  const servingGrams = Number(food['Serving grams']);\n  const multiplier = (entry.unit === 'serving' || !servingGrams) ? entry.quantity : entry.quantity / servingGrams;\n  const round1 = n => Math.round(n * 10) / 10;\n  return {\n    json: {\n      day,\n      date,\n      foodItem: food['Food name'],\n      quantity: entry.quantity + ' ' + entry.unit,\n      servingSize: food['Serving size'],\n      calories: round1(Number(food['Calories']) * multiplier),\n      protein: round1(Number(food['Protein']) * multiplier),\n      carbs: round1(Number(food['Carbs']) * multiplier),\n      fats: round1(Number(food['Fats']) * multiplier)\n    }\n  };\n});"}},
    {"id":"3cc98459-d672-453e-acb5-b31a8c8f7dba","name":"Append Tracking Row","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[1140,300],"parameters":{"resource":"sheet","operation":"append","documentId":{"__rl":true,"mode":"id","value":"YOUR_GOOGLE_SHEET_ID","cachedResultName":"Food Tracker"},"sheetName":{"__rl":true,"mode":"id","value":"1337083894","cachedResultName":"tracking table"},"columns":{"mappingMode":"defineBelow","value":{"Day":"={{ $json.day }}","Date":"={{ $json.date }}","Food Item":"={{ $json.foodItem }}","Quantity":"={{ $json.quantity }}","Serving size":"={{ $json.servingSize }}","Calories":"={{ $json.calories }}","Protein":"={{ $json.protein }}","Carbs":"={{ $json.carbs }}","Fats":"={{ $json.fats }}"},"schema":[{"id":"Day","displayName":"Day","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Date","displayName":"Date","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Food Item","displayName":"Food Item","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Quantity","displayName":"Quantity","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Serving size","displayName":"Serving size","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Calories","displayName":"Calories","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Protein","displayName":"Protein","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Carbs","displayName":"Carbs","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Fats","displayName":"Fats","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false}]}},"retryOnFail":true},
    {"id":"38e9e91a-7b1a-4d5f-a47e-eadef8032d43","name":"Read Today Totals","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[1340,300],"parameters":{"resource":"sheet","operation":"read","documentId":{"__rl":true,"mode":"id","value":"YOUR_GOOGLE_SHEET_ID","cachedResultName":"Food Tracker"},"sheetName":{"__rl":true,"mode":"id","value":"831389553","cachedResultName":"total daily macros tracking table"},"filtersUI":{"values":[{"lookupColumn":"Date","lookupValue":"={{ $now.setZone('Asia/Kolkata').toFormat('LLLL d') }}"}]},"combineFilters":"AND","options":{}},"executeOnce":true,"retryOnFail":true,"alwaysOutputData":true},
    {"id":"af0e921e-9094-48b0-9e07-d11da7d6c682","name":"Compute New Totals","type":"n8n-nodes-base.code","typeVersion":2,"position":[1540,300],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const loggedEntries = $('Build Entry Rows').all().map(item => item.json);\nconst existing = $input.all().map(item => item.json).find(r => r['Total Calories'] !== undefined) || {};\nconst now = $now.setZone('Asia/Kolkata');\nconst day = now.toFormat('cccc');\nconst date = now.toFormat('LLLL d');\n\nconst sum = (key) => loggedEntries.reduce((acc, e) => acc + e[key], 0);\nconst round1 = n => Math.round(n * 10) / 10;\n\nconst baseCalories = Number(existing['Total Calories']) || 0;\nconst baseProtein = Number(existing['Total Protein (g)']) || 0;\nconst baseCarbs = Number(existing['Total Carbs (g)']) || 0;\nconst baseFats = Number(existing['Total Fats (g)']) || 0;\n\nreturn [{\n  json: {\n    day,\n    date,\n    totalCalories: round1(baseCalories + sum('calories')),\n    totalProtein: round1(baseProtein + sum('protein')),\n    totalCarbs: round1(baseCarbs + sum('carbs')),\n    totalFats: round1(baseFats + sum('fats')),\n    loggedEntries\n  }\n}];"}},
    {"id":"6cccf29e-2e7b-4864-a890-e825a77534d0","name":"Upsert Daily Totals","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[1740,300],"parameters":{"resource":"sheet","operation":"appendOrUpdate","documentId":{"__rl":true,"mode":"id","value":"YOUR_GOOGLE_SHEET_ID","cachedResultName":"Food Tracker"},"sheetName":{"__rl":true,"mode":"id","value":"831389553","cachedResultName":"total daily macros tracking table"},"columns":{"mappingMode":"defineBelow","matchingColumns":["Date"],"value":{"Day":"={{ $json.day }}","Date":"={{ $json.date }}","Total Calories":"={{ $json.totalCalories }}","Total Protein (g)":"={{ $json.totalProtein }}","Total Carbs (g)":"={{ $json.totalCarbs }}","Total Fats (g)":"={{ $json.totalFats }}"},"schema":[{"id":"Day","displayName":"Day","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Date","displayName":"Date","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true},{"id":"Total Calories","displayName":"Total Calories","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Total Protein (g)","displayName":"Total Protein (g)","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Total Carbs (g)","displayName":"Total Carbs (g)","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false},{"id":"Total Fats (g)","displayName":"Total Fats (g)","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":false}]}},"retryOnFail":true},
    {"id":"9e8acd54-e432-4192-b675-ae9771a44105","name":"Build Summary","type":"n8n-nodes-base.code","typeVersion":2,"position":[1940,300],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const totals = $('Compute New Totals').first().json;\nreturn [{\n  json: {\n    logged: totals.loggedEntries,\n    todayTotals: {\n      calories: totals.totalCalories,\n      protein: totals.totalProtein,\n      carbs: totals.totalCarbs,\n      fats: totals.totalFats\n    }\n  }\n}];"}}
